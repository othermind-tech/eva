# Production build — build/main.js's serveFrontend() DOES proxy /api/* to the
# backend (same as Vite's dev proxy), so this must stay relative/same-origin.
# An absolute cross-origin URL here (e.g. http://127.0.0.1:8000) is blocked by
# main.js's own CSP (connect-src 'self') before the request even leaves the
# renderer — confirmed live 2026-09-23, see tests/electron/test_preview_relay.js.
# Vite bakes this value directly into the bundle at build time.
VITE_API_BASE=/api
